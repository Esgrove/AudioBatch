# Default C++ gitignore
# https://github.com/github/gitignore

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
/cpp/audiobatch

# Build

/assets/icon.afdesign
/assets/sound.png
/cpp/build
/cpp/Builds
/cpp/cmake-build*

# Test audio files
/cpp/files/
/cpp/test/
/cpp/screenshots/

# Allow checked-in workspace settings for shared CMake/IntelliSense config.
!/.vscode/
/.vscode/*
!/.vscode/settings.json

# Local agent settings
/.claude/settings.local.json

.zed/
