# Default C++ gitignore
# https://github.com/github/gitignore

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
/cpp/audiobatch

# Build

/assets/icon.afdesign
/assets/sound.png
/cpp/build
/cpp/Builds
/cpp/cmake-build*
/test-plugin/build
/test-plugin/build-debug
/image-control-plugin/build
/image-control-plugin/build-debug
/image-control-plugin/build-benchmark
# Dependencies shared by the plugin builds, such as pluginval
/.deps

# Test audio files
/cpp/files/
/cpp/test/
/cpp/screenshots/
/cpp/fuzz-artifacts/
/cpp/fuzz-scratch/

# Allow checked-in workspace settings for shared CMake/IntelliSense config.
!/.vscode/
/.vscode/*
!/.vscode/settings.json

# Local agent settings
/.claude/settings.local.json

.zed/

# Local test files
/files/

# Generated benchmark audio
/fixtures/benchmark/output/

# Other
*.pdf
