# Copy to .env.local, which is git-ignored and loaded by common.sh.
# Variables already set in the environment override these values.
# The notarization password is not stored here, only in the keychain profile.
APPLE_TEAM_ID=YOURTEAMID
APPLE_ID=your-apple-id@example.com
APPLE_DEVELOPER_ORG=Your Name
APPLE_NOTARY_PROFILE=audiobatch-notary
# Set these only when the certificate names differ from "Developer ID Application: <org> (<team-id>)".
# CODESIGN_IDENTITY=Developer ID Application: Your Name (YOURTEAMID)
# INSTALLER_SIGN_IDENTITY=Developer ID Installer: Your Name (YOURTEAMID)
