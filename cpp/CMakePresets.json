{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ninja-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_SYSROOT": "macosx"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "description": "Use Visual Studio 18 2026 with x64 output in cmake-build-windows-debug.",
      "inherits": "windows-vs2026-base",
      "binaryDir": "${sourceDir}/cmake-build-windows-debug"
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "description": "Use Visual Studio 18 2026 with x64 output in cmake-build-windows-release.",
      "inherits": "windows-vs2026-base",
      "binaryDir": "${sourceDir}/cmake-build-windows-release"
    },
    {
      "name": "windows-asan",
      "displayName": "Windows AddressSanitizer",
      "description": "Debug build with AddressSanitizer using Visual Studio 18 2026 in cmake-build-windows-asan.",
      "inherits": "windows-vs2026-base",
      "binaryDir": "${sourceDir}/cmake-build-windows-asan",
      "cacheVariables": {
        "AUDIOBATCH_SANITIZE": "address"
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows Ninja Debug",
      "description": "Use Ninja with the MSVC toolchain in cmake-build-windows-ninja-debug for compile_commands.json support.",
      "inherits": "windows-ninja-msvc-base",
      "binaryDir": "${sourceDir}/cmake-build-windows-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows Ninja Release",
      "description": "Use Ninja with the MSVC toolchain in cmake-build-windows-ninja-release for compile_commands.json support.",
      "inherits": "windows-ninja-msvc-base",
      "binaryDir": "${sourceDir}/cmake-build-windows-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "description": "Use Ninja with clang output in cmake-build-mac-debug.",
      "inherits": "macos-ninja-base",
      "binaryDir": "${sourceDir}/cmake-build-mac-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "description": "Use Ninja with clang output in cmake-build-mac-release.",
      "inherits": "macos-ninja-base",
      "binaryDir": "${sourceDir}/cmake-build-mac-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-asan",
      "displayName": "macOS ASan",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer in cmake-build-mac-asan.",
      "inherits": "macos-ninja-base",
      "binaryDir": "${sourceDir}/cmake-build-mac-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUDIOBATCH_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "macos-tsan",
      "displayName": "macOS TSan",
      "description": "Debug build with ThreadSanitizer in cmake-build-mac-tsan.",
      "inherits": "macos-ninja-base",
      "binaryDir": "${sourceDir}/cmake-build-mac-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUDIOBATCH_SANITIZE": "thread"
      }
    },
    {
      "name": "macos-fuzz",
      "displayName": "macOS Fuzz",
      "description": "libFuzzer harnesses with AddressSanitizer and UndefinedBehaviorSanitizer, built with Homebrew LLVM in cmake-build-mac-fuzz.",
      "inherits": "macos-ninja-base",
      "binaryDir": "${sourceDir}/cmake-build-mac-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "AUDIOBATCH_FUZZ": "ON",
        "AUDIOBATCH_SANITIZE": "address,undefined",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "configuration": "Debug"
    },
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja-debug"
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "macos-asan",
      "configurePreset": "macos-asan"
    },
    {
      "name": "macos-tsan",
      "configurePreset": "macos-tsan"
    },
    {
      "name": "macos-fuzz",
      "configurePreset": "macos-fuzz",
      "targets": ["SeratoTagFuzzer", "CliArgumentsFuzzer"]
    }
  ]
}
